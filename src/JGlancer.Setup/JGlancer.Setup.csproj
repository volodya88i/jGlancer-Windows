<Project Sdk="Microsoft.NET.Sdk">
  <!-- The setup stub (W-73): unpacks the app appended to it and starts the app in its setup mode. No UI of its own. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>JGlancer.Setup</RootNamespace>
    <AssemblyName>jGlancer-Setup</AssemblyName>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <ApplicationIcon>jGlancer.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType>none</DebugType>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
</Project>
