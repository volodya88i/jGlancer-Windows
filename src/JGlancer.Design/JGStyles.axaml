<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:JGlancer.Design"
        xmlns:conv="using:Avalonia.Controls.Converters"
        x:Class="JGlancer.Design.JGStyles">
  <!-- Control themes of the design system (DESIGN.md §5–7). Colors come only from the JG.* token brushes,
       sizes only from JGMetrics / JGSpacing. -->
  <Styles.Resources>
    <ResourceDictionary>
      <CornerRadius x:Key="JG.radius.small">6</CornerRadius>
      <CornerRadius x:Key="JG.radius.medium">8</CornerRadius>
      <CornerRadius x:Key="JG.radius.large">12</CornerRadius>
      <SolidColorBrush x:Key="JG.captionCloseHover" Color="{x:Static d:JGTheme.CaptionCloseHoverColor}" />

      <!-- Buttons: primary (text.primary block, bg.base label), secondary (outline), tertiary (text only). -->
      <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.line.strong}" />
        <Setter Property="BorderThickness" Value="{x:Static d:JGInsets.Outline}" />
        <Setter Property="CornerRadius" Value="{StaticResource JG.radius.small}" />
        <Setter Property="MinHeight" Value="{x:Static d:JGMetrics.ControlHeight}" />
        <Setter Property="Padding" Value="{x:Static d:JGInsets.Button}" />
        <Setter Property="FontFamily" Value="{x:Static d:JGFonts.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource JG.bg.raised}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Opacity" Value="{x:Static d:JGMetrics.PressedOpacity}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="{x:Static d:JGMetrics.PlaceholderOpacity}" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderBrush" Value="{DynamicResource JG.accent}" />
        </Style>
        <Style Selector="^.primary">
          <Setter Property="Background" Value="{DynamicResource JG.text.primary}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.bg.base}" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^.primary:pointerover">
          <Setter Property="Background" Value="{DynamicResource JG.text.primary}" />
          <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="^.tertiary">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.secondary}" />
        </Style>
        <Style Selector="^.icon">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="6" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="CornerRadius" Value="{StaticResource JG.radius.small}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.secondary}" />
        </Style>
        <Style Selector="^.icon:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <!-- The viewers' borderless icon buttons (macOS ViewerIconButton): a control-height square, primary glyph. -->
        <Style Selector="^.viewer">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Width" Value="{x:Static d:JGMetrics.ControlHeight}" />
          <Setter Property="Height" Value="{x:Static d:JGMetrics.ControlHeight}" />
          <Setter Property="CornerRadius" Value="{StaticResource JG.radius.small}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <!-- A viewer toggle that is on (loop, play next): the accent glyph (macOS ViewerIconButton isOn). -->
        <Style Selector="^.viewer.on">
          <Setter Property="Foreground" Value="{DynamicResource JG.accent.text}" />
        </Style>
        <!-- The photo viewer's round ‹ › at the sides, on the scrim. -->
        <Style Selector="^.page">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Width" Value="{x:Static d:JGMetrics.PageButtonSide}" />
          <Setter Property="Height" Value="{x:Static d:JGMetrics.PageButtonSide}" />
          <Setter Property="CornerRadius" Value="{x:Static d:JGLayout.PageButtonRadius}" />
          <Setter Property="Background" Value="{DynamicResource JG.overlay.scrim}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <Style Selector="^.page:pointerover">
          <Setter Property="Background" Value="{DynamicResource JG.overlay.scrim}" />
        </Style>
        <!-- The chevron above a filmstrip in Button mode (macOS FilmstripToggle): hides and shows it. -->
        <Style Selector="^.filmstripToggle">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Width" Value="{x:Static d:JGMetrics.FilmstripToggleWidth}" />
          <Setter Property="Height" Value="{x:Static d:JGMetrics.FilmstripToggleHeight}" />
          <Setter Property="Margin" Value="0,0,0,4" />
          <Setter Property="CornerRadius" Value="{StaticResource JG.radius.small}" />
          <Setter Property="Background" Value="{DynamicResource JG.overlay.scrim}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <Style Selector="^.filmstripToggle:pointerover">
          <Setter Property="Background" Value="{DynamicResource JG.overlay.scrim}" />
        </Style>
        <!-- One choice of a segmented picker (Settings): the chosen one raised in primary text, the others quiet. -->
        <Style Selector="^.segment">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="MinHeight" Value="{x:Static d:JGMetrics.ControlHeightCompact}" />
          <Setter Property="CornerRadius" Value="{StaticResource JG.radius.small}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.secondary}" />
          <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="^.segment.on">
          <Setter Property="Background" Value="{DynamicResource JG.bg.raised}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
          <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <!-- A large choice card (the Performance / Beauty looks): hairline, the chosen one edged in the accent. -->
        <Style Selector="^.card">
          <Setter Property="Background" Value="{DynamicResource JG.bg.panel}" />
          <Setter Property="BorderBrush" Value="{DynamicResource JG.line.hair}" />
          <Setter Property="CornerRadius" Value="{StaticResource JG.radius.large}" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="^.card:pointerover">
          <Setter Property="Background" Value="{DynamicResource JG.bg.panel}" />
          <Setter Property="BorderBrush" Value="{DynamicResource JG.line.strong}" />
        </Style>
        <Style Selector="^.card.on">
          <Setter Property="BorderBrush" Value="{DynamicResource JG.accent}" />
        </Style>
      </ControlTheme>

      <!-- Window caption buttons (W-04): Windows sizes and glyphs, our colors; close turns red on hover. -->
      <ControlTheme x:Key="JG.captionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource JG.text.secondary}" />
        <Setter Property="Width" Value="{x:Static d:JGMetrics.CaptionButtonWidth}" />
        <Setter Property="FontFamily" Value="{x:Static d:JGFonts.Caption}" />
        <Setter Property="FontSize" Value="{x:Static d:JGMetrics.CaptionGlyphSize}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource JG.bg.raised}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <Style Selector="^.close:pointerover">
          <Setter Property="Background" Value="{StaticResource JG.captionCloseHover}" />
          <Setter Property="Foreground" Value="White" />
        </Style>
      </ControlTheme>

      <!-- Menu bar (W-04) and its items. -->
      <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerTheme" Value="{DynamicResource JG.topLevelMenuItem}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              VerticalAlignment="Stretch"
                              KeyboardNavigation.TabNavigation="Continue" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="JG.menuPopup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource JG.bg.popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.line.strong}" />
        <Setter Property="BorderThickness" Value="{x:Static d:JGInsets.Outline}" />
        <Setter Property="CornerRadius" Value="{StaticResource JG.radius.medium}" />
        <Setter Property="Padding" Value="{x:Static d:JGInsets.MenuPopup}" />
        <Setter Property="MinWidth" Value="{x:Static d:JGMetrics.MenuMinWidth}" />
        <Setter Property="BoxShadow" Value="0 4 12 0 #33000000" />
      </ControlTheme>

      <ControlTheme x:Key="JG.topLevelMenuItem" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        <Setter Property="FontFamily" Value="{x:Static d:JGFonts.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_LayoutRoot"
                      Background="{TemplateBinding Background}"
                      CornerRadius="{StaticResource JG.radius.small}"
                      Padding="{TemplateBinding Padding}"
                      Margin="0,4">
                <ContentPresenter Name="PART_HeaderPresenter"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
              <Popup Name="PART_Popup"
                     WindowManagerAddShadowHint="False"
                     IsLightDismissEnabled="True"
                     IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                     Placement="BottomEdgeAlignedLeft"
                     VerticalOffset="2"
                     OverlayInputPassThroughElement="{Binding $parent[Menu]}">
                <Border Theme="{StaticResource JG.menuPopup}" Margin="0,0,12,12">
                  <ScrollViewer>
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    Grid.IsSharedSizeScope="True" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource JG.bg.raised}" />
        </Style>
        <Style Selector="^:open /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource JG.bg.raised}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        <Setter Property="FontFamily" Value="{x:Static d:JGFonts.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="{x:Static d:JGMetrics.ControlHeightCompact}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_LayoutRoot"
                      Background="{TemplateBinding Background}"
                      CornerRadius="{StaticResource JG.radius.small}"
                      MinHeight="{TemplateBinding MinHeight}"
                      Padding="{TemplateBinding Padding}">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <!-- No shared size groups: at fractional screen scales they grew rows after the popup had sized
                         itself, and the right end (hint, chevron) was cut off. Rows stretch to the widest one; hints
                         sit right-aligned before the chevron. -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                  </Grid.ColumnDefinitions>
                  <!-- Toggle items keep the check's place whether checked or not, so their names line up. -->
                  <d:JGIcon Name="PART_Check"
                            Width="14" Height="14"
                            Margin="0,0,8,0"
                            IsVisible="False"
                            Opacity="0"
                            Data="{x:Static d:JGIconData.Check}"
                            Foreground="{DynamicResource JG.text.primary}" />
                  <!-- A program's icon (Open With). -->
                  <ContentPresenter Name="PART_IconPresenter"
                                    Content="{TemplateBinding Icon}"
                                    Width="{x:Static d:JGMetrics.IconSize}" Height="{x:Static d:JGMetrics.IconSize}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <ContentPresenter Name="PART_HeaderPresenter"
                                    Grid.Column="1"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                  <TextBlock Name="PART_InputGestureText"
                             Grid.Column="2"
                             Classes="mono"
                             Margin="24,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource JG.text.tertiary}"
                             Text="{TemplateBinding InputGesture, Converter={x:Static d:JGConverters.KeyGesture}}" />
                  <d:JGIcon Name="PART_Chevron"
                            Grid.Column="3"
                            Width="12" Height="12"
                            HorizontalAlignment="Right"
                            Data="{x:Static d:JGIconData.ChevronRight}"
                            Foreground="{DynamicResource JG.text.secondary}" />
                </Grid>
              </Border>
              <Popup Name="PART_Popup"
                     WindowManagerAddShadowHint="False"
                     IsLightDismissEnabled="False"
                     IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                     Placement="RightEdgeAlignedTop"
                     HorizontalOffset="4">
                <Border Theme="{StaticResource JG.menuPopup}" Margin="0,0,12,12">
                  <ScrollViewer>
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    Grid.IsSharedSizeScope="True" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:empty /template/ d|JGIcon#PART_Chevron">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[ToggleType=CheckBox] /template/ d|JGIcon#PART_Check, ^[ToggleType=Radio] /template/ d|JGIcon#PART_Check">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:checked /template/ d|JGIcon#PART_Check">
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource JG.accent.dim}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="{x:Static d:JGMetrics.PlaceholderOpacity}" />
        </Style>
      </ControlTheme>

      <!-- Drop-down menus of buttons (sort) and context menus share the menu popup look. -->
      <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Theme="{StaticResource JG.menuPopup}">
              <ScrollViewer>
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                Grid.IsSharedSizeScope="True"
                                KeyboardNavigation.TabNavigation="Continue" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Theme="{StaticResource JG.menuPopup}">
              <ScrollViewer>
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                Grid.IsSharedSizeScope="True"
                                KeyboardNavigation.TabNavigation="Continue" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Filter toggles, in words (Video, Photo, Audio, Everywhere): quiet until chosen, then raised in primary text. -->
      <ControlTheme x:Key="JG.chip" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource JG.text.secondary}" />
        <Setter Property="Height" Value="{x:Static d:JGMetrics.ControlHeightCompact}" />
        <Setter Property="Padding" Value="{x:Static d:JGInsets.Button}" />
        <Setter Property="CornerRadius" Value="{StaticResource JG.radius.small}" />
        <Setter Property="FontFamily" Value="{x:Static d:JGFonts.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{DynamicResource JG.bg.raised}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Opacity" Value="{x:Static d:JGMetrics.PressedOpacity}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Root">
          <Setter Property="BorderBrush" Value="{DynamicResource JG.accent}" />
          <Setter Property="BorderThickness" Value="{x:Static d:JGInsets.Outline}" />
        </Style>
      </ControlTheme>

      <!-- The same filters as icons: a square each, quiet until chosen, then raised in primary color. -->
      <ControlTheme x:Key="JG.iconToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource JG.text.secondary}" />
        <Setter Property="Width" Value="{x:Static d:JGMetrics.ControlHeightCompact}" />
        <Setter Property="Height" Value="{x:Static d:JGMetrics.ControlHeightCompact}" />
        <Setter Property="CornerRadius" Value="{StaticResource JG.radius.small}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{DynamicResource JG.bg.raised}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Opacity" Value="{x:Static d:JGMetrics.PressedOpacity}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Root">
          <Setter Property="BorderBrush" Value="{DynamicResource JG.accent}" />
          <Setter Property="BorderThickness" Value="{x:Static d:JGInsets.Outline}" />
        </Style>
      </ControlTheme>

      <!-- A sidebar row (folder, Trash): selected = bg.raised, hover = bg.raised at half strength. -->
      <ControlTheme x:Key="JG.sidebarRow" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource JG.text.secondary}" />
        <Setter Property="Height" Value="{x:Static d:JGMetrics.ControlHeightCompact}" />
        <Setter Property="Padding" Value="{x:Static d:JGInsets.SidebarRow}" />
        <Setter Property="CornerRadius" Value="{StaticResource JG.radius.small}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource JG.bg.raised}" />
        </Style>
        <Style Selector="^.selected">
          <Setter Property="Background" Value="{DynamicResource JG.bg.raised}" />
          <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
        </Style>
        <Style Selector="^.dropTarget /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderBrush" Value="{DynamicResource JG.accent}" />
          <Setter Property="BorderThickness" Value="2" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource JG.line.hair}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Text fields (rename, patterns): the app's surfaces and accent, not the Windows accent color Fluent uses. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource JG.bg.base}" />
    <Setter Property="Foreground" Value="{DynamicResource JG.text.primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JG.line.strong}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource JG.accent.dim}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource JG.text.primary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource JG.text.primary}" />
    <Setter Property="CornerRadius" Value="{StaticResource JG.radius.small}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource JG.bg.base}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JG.text.tertiary}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource JG.bg.base}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JG.accent}" />
    <Setter Property="BorderThickness" Value="{x:Static d:JGInsets.Outline}" />
  </Style>
  <Style Selector="TextBox:focus /template/ TextBlock#PART_PlaceholderText, TextBox /template/ TextBlock#PART_PlaceholderText">
    <Setter Property="Foreground" Value="{DynamicResource JG.text.tertiary}" />
  </Style>

  <!-- The top bar's search field: the text alone inside its own raised capsule (no border of its own). -->
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement, TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource JG.text.tertiary}" />
  </Style>
</Styles>
