<Project Sdk="Microsoft.NET.Sdk">
  <!-- The stem splitter's network (W-85): Demucs as ONNX through ONNX Runtime, on the GPU with DirectML or the CPU. -->
  <PropertyGroup>
    <RootNamespace>JGlancer.Stems</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
  </ItemGroup>
  <ItemGroup>
    <!-- DirectML.dll itself (the version ONNX Runtime 1.24.4 depends on): its package copies it only into some outputs,
         and Windows' own older copy in System32 is not enough. -->
    <None Include="$(NuGetPackageRoot)microsoft.ai.directml\1.15.4\bin\x64-win\DirectML.dll" Link="DirectML.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JGlancer.Core\JGlancer.Core.csproj" />
  </ItemGroup>
</Project>
